  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b556997221b11404f81fe4e18e9cf79a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: TestingLab.Gameplay::TestingLab.Gameplay.UI.LabNotesOverlay
  title: Arena
  notes: "<b>ARENA</b>  \u2014 every system on screen and its test\n\n<b>Health bar,
    damage, armor</b>   Health, DamageCalculator\n  \u2192 EditMode \u25B8 Level1_Beginner
    \u25B8 HealthTests\n  \u2192 EditMode \u25B8 Level2_Intermediate \u25B8 DamageCalculatorTests
    (fake random)\n  \u2192 PlayMode \u25B8 Level2_Intermediate \u25B8 ContactDamageTests
    (real triggers)\n\n<b>Score & combo x2..x4</b>   ScoreKeeper\n  \u2192 EditMode
    \u25B8 Level2_Intermediate \u25B8 ScoreKeeperTests (fake clock)\n\n<b>Timer,
    coin goal, win/lose, pause</b>   GameSession\n  \u2192 EditMode \u25B8 Level2_Intermediate
    \u25B8 GameSessionTests (state machine)\n  \u2192 EditMode \u25B8 Level1_Beginner
    \u25B8 TimeFormatterTests\n\n<b>Waves of coins & enemies</b>   WaveSchedule,
    SpawnPointPicker\n  \u2192 EditMode \u25B8 Level2_Intermediate \u25B8 WaveScheduleTests,
    SpawnPointPickerTests\n\n<b>Enemy chasing</b>   ChaseBrain (decisions) + Mover
    (movement)\n  \u2192 EditMode \u25B8 Level2_Intermediate \u25B8 ChaseBrainTests\n 
    \u2192 PlayMode \u25B8 Level2_Intermediate \u25B8 MoverTests\n\n<b>Picking up
    coins</b>   Collector + Collectible (physics triggers)\n  \u2192 PlayMode \u25B8
    Level2_Intermediate \u25B8 CollectibleTests\n\n<b>Player movement</b>   MovementMath
    + PlayerController\n  \u2192 EditMode \u25B8 Level2_Intermediate \u25B8 MovementMathTests\n 
    \u2192 PlayMode \u25B8 Level2_Intermediate \u25B8 PlayerControllerTests (scripted
    input)\n\n<b>The whole thing wired together</b>\n  \u2192 PlayMode \u25B8 Level3_Advanced
    \u25B8 ArenaSceneTests\n\n<b>Are the level numbers even winnable?</b>\n  \u2192
    EditMode \u25B8 Level3_Advanced \u25B8 LevelAssetValidationTests"
