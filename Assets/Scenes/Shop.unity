  m_Script: {fileID: 11500000, guid: b556997221b11404f81fe4e18e9cf79a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: TestingLab.Gameplay::TestingLab.Gameplay.UI.LabNotesOverlay
  title: Shop
  notes: "<b>SHOP</b>  \u2014 \u26A0 contains deliberate bugs!\n\nTry it: add the
    same item twice. Look at the cart.\nTry it: coupon code MEGA150. Look at the
    total, then Checkout.\n\nThese are the ShopCart bug-hunt bugs. Reproduce each
    one as a\nfailing unit test BEFORE fixing it:\n  \u2192 EditMode \u25B8 Exercises
    \u25B8 Level2_Intermediate \u25B8 ShopCartBugHuntTests\n\n<b>Checkout rules</b>
    (money, effects, nothing changes on failure)\n  \u2192 EditMode \u25B8 Level2_Intermediate
    \u25B8 ShopServiceTests\n<b>Item effects</b> (Strategy pattern)\n  \u2192 EditMode
    \u25B8 Level2_Intermediate \u25B8 ItemEffectTests\n<b>Coupons</b>\n  \u2192 EditMode
    \u25B8 Level1_Beginner \u25B8 CouponBookTests\n<b>Buying through the real UI</b>\n 
    \u2192 PlayMode \u25B8 Level3_Advanced \u25B8 ShopSceneTests"
